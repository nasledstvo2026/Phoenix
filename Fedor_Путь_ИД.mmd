flowchart LR
    %% ─────────── 1. ИСТОЧНИКИ ИД (с чего начинается) ───────────
    SRC(["ИСТОЧНИКИ ИД<br/>кто выдаёт документ"]):::start
    S1["Суды (ОЮ, арбитражные)<br/>исполнительный лист"]:::src
    S2["Мировой судья<br/>судебный приказ"]:::src
    S3["Налоговый орган<br/>постановление о взыскании"]:::nksrc
    S4["Нотариус<br/>соглашение об алиментах / медиативное"]:::src
    S5["ФССП / пристав,<br/>контрольные и гос. органы"]:::src

    SRC ==> S1
    SRC ==> S2
    SRC ==> S3
    SRC ==> S4
    SRC ==> S5

    %% ─────────── 2. ПУТЬ ИД — ЧЕРЕЗ ФЗ ───────────
    V["ВЫДАЧА ИД<br/>229-ФЗ: ст. 12 (виды), ст. 13 (требования)"]:::law229
    S1 ==> V
    S2 ==> V
    S3 ==> V
    S4 ==> V
    S5 ==> V

    P["ПРЕДЪЯВЛЕНИЕ К ИСПОЛНЕНИЮ<br/>229-ФЗ: ст. 21 (сроки), ст. 22 (перерыв)"]:::law229
    V ==> P

    PB["Напрямую в банк взыскателем<br/>229-ФЗ: ст. 8"]:::law229
    P ==> PB
    PB --> L5

    VZ["ВОЗБУЖДЕНИЕ ИП<br/>229-ФЗ: ст. 30 (3 дня); отказ — ст. 31"]:::law229
    P ==> VZ

    DB["ДОБРОВОЛЬНОЕ ИСПОЛНЕНИЕ<br/>229-ФЗ: ст. 30 ч. 11–12 (5 дней)"]:::law229
    VZ ==> DB

    L5["ПРИНУДИТЕЛЬНОЕ ИСПОЛНЕНИЕ<br/>229-ФЗ: ст. 36 (2 мес.), ст. 64, 68"]:::law229
    DB ==> L5

    BANK["Взыскание через банк<br/>НК РФ ч.1: ст. 46, 60"]:::lawNK
    ORD["Очерёдность списания<br/>ГК РФ ч.2: ст. 855"]:::lawGK
    BR["Приостановление при банкротстве<br/>127-ФЗ: ст. 223.4 / 223.6"]:::law127
    L5 ==> BANK
    L5 ==> ORD
    L5 ==> BR

    %% ─────────── 3. ЗАВЕРШЕНИЕ — ЧЕМ ЗАКАНЧИВАЕТСЯ ───────────
    FIN["ОКОНЧАНИЕ ИП<br/>229-ФЗ: ст. 47"]:::law229
    BANK ==> FIN
    ORD ==> FIN
    BR ==> FIN

    DONE(["ЗАВЕРШЕНО<br/>требования исполнены"]):::end2
    RET["ВОЗВРАТ ИД взыскателю<br/>229-ФЗ: ст. 46 (взыскание невозможно)"]:::law229
    STOP["ПРЕКРАЩЕНИЕ ИП<br/>229-ФЗ: ст. 43"]:::law229
    FIN ==> DONE
    FIN ==> RET
    FIN ==> STOP

    AGAIN["ПОВТОРНОЕ ПРЕДЪЯВЛЕНИЕ<br/>229-ФЗ: ст. 46 ч. 4 (сроки ст. 21)"]:::law229
    RET ==> AGAIN
    AGAIN -.->|"новый цикл"| P

    %% 425-ФЗ — изменяющий (отложенный эффект)
    F425["425-ФЗ — изменяющий<br/>меняет НК ст. 46/60 — только с 01.01.2027"]:::prof
    F425 -.->|"amends"| BANK

