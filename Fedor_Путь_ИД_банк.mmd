flowchart TD
    %% ─── ИСТОЧНИКИ ИД ───
    SRC(["ИСТОЧНИКИ ИД"]):::start
    S1["Суды → исполнительный лист"]:::src
    S2["Мировой судья → судебный приказ"]:::src
    S3["ФНС (налоговый орган)<br/>постановление о взыскании"]:::nksrc
    S4["Нотариус → соглашение об алиментах"]:::src
    S5["ФССП, контрольные и гос. органы"]:::src
    SRC ==> S1 & S2 & S3 & S4 & S5

    %% ─── ПУТЬ ЧЕРЕЗ ФЗ ───
    V["ВЫДАЧА ИД<br/>229-ФЗ: ст. 12–13"]:::law229
    S1 ==> V
    S2 ==> V
    S3 ==> V
    S4 ==> V
    S5 ==> V

    P["ПРЕДЪЯВЛЕНИЕ К ИСПОЛНЕНИЮ<br/>229-ФЗ: ст. 21–22"]:::law229
    V ==> P

    PB["ПРЕДЪЯВЛЕНИЕ НАПРЯМУЮ В БАНК<br/>229-ФЗ: ст. 8"]:::bank
    P ==> PB

    VZ["ВОЗБУЖДЕНИЕ ИП<br/>229-ФЗ: ст. 30"]:::law229
    P ==> VZ
    DB["ДОБРОВОЛЬНОЕ ИСПОЛНЕНИЕ<br/>229-ФЗ: ст. 30 ч. 11–12"]:::law229
    VZ ==> DB
    L5["ПРИНУДИТЕЛЬНОЕ ИСПОЛНЕНИЕ<br/>229-ФЗ: ст. 36, 64, 68"]:::law229
    DB ==> L5

    %% ─── ЗОНА ОТВЕТСТВЕННОСТИ БАНКА ───
    BANK["ИСПОЛНЕНИЕ ПОРУЧЕНИЙ ФНС (налогового органа)<br/>НК РФ ч.1: ст. 46, 60<br/>3 часа (с 01.01.2027) / 1 опер. день"]:::bank
    ORD["ОЧЕРЁДНОСТЬ СПИСАНИЯ<br/>ГК РФ ч.2: ст. 855"]:::bank
    DUTY["ОБЯЗАННОСТИ БАНКА (НК ст. 60)<br/>исполнить · не задерживать ·<br/>сообщить о неисполнении на след. день"]:::bank
    ROZ["РОЗЫСК СЧЁТОВ<br/>ПНО только по ИНН — с 01.01.2027"]:::bank
    RESP["ОТВЕТСТВЕННОСТЬ БАНКА (НК ст. 135)<br/>1/150 ставки, ≤ 0,2%/день;<br/>30% за создание отсутствия средств"]:::bank

    L5 ==> BANK
    BANK ==> ORD
    BANK --> DUTY
    BANK --> ROZ
    BANK --> RESP
    PB --> BANK

    F425["425-ФЗ — изменяющий<br/>меняет НК ст. 46/60 — с 01.01.2027"]:::prof
    F425 -.->|"amends"| BANK

    %% ─── ЗАВЕРШЕНИЕ ───
    FIN["ОКОНЧАНИЕ ИП<br/>229-ФЗ: ст. 47"]:::law229
    BANK ==> FIN
    ORD ==> FIN
    DONE(["ЗАВЕРШЕНО<br/>исполнено"]):::end2
    RET["ВОЗВРАТ ИД взыскателю<br/>229-ФЗ: ст. 46"]:::law229
    STOP["ПРЕКРАЩЕНИЕ ИП<br/>229-ФЗ: ст. 43"]:::law229
    FIN ==> DONE
    FIN ==> RET
    FIN ==> STOP
    AGAIN["ПОВТОРНОЕ ПРЕДЪЯВЛЕНИЕ<br/>229-ФЗ: ст. 46 ч. 4"]:::law229
    RET ==> AGAIN
    AGAIN -.->|"новый цикл"| P

    %% ─── (легенда вынесена наверх отдельной полосой при постобработке) ───

    classDef start fill:#5eead4,stroke:#0f172a,stroke-width:2px
    classDef end2 fill:#86efac,stroke:#0f172a,stroke-width:2px
    classDef src fill:#f1f5f9,stroke:#334155
    classDef nksrc fill:#fed7aa,stroke:#ea580c
    classDef law229 fill:#bae1ff,stroke:#1d4ed8,stroke-width:2px
    classDef prof fill:#ffb3ba,stroke:#dc2626,stroke-width:3px
    classDef bank fill:#fde68a,stroke:#b45309,stroke-width:3px
