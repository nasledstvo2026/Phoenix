{
  "agents": {
    "defaults": {
      "maxConcurrent": 4,
      "workspace": "/home/user1/phoenix/",
      "models": {
        "deepseek/deepseek-v4-flash": {
          "alias": "DeepSeek"
        },
        "deepseek/deepseek-v4-pro": {}
      },
      "model": {
        "primary": "deepseek/deepseek-v4-pro",
        "fallbacks": [
          "deepseek/deepseek-v4-flash"
        ]
      },
      "memorySearch": {
        "enabled": false
      }
    },
    "list": [
      {
        "id": "main"
      },
      {
        "id": "fz425-agent",
        "model": {
          "primary": "deepseek/deepseek-v4-pro",
          "fallbacks": [
            "deepseek/deepseek-v4-flash"
          ]
        }
      },
      {
        "id": "fz425-verifier",
        "model": {
          "primary": "deepseek/deepseek-v4-pro",
          "fallbacks": [
            "deepseek/deepseek-v4-flash"
          ]
        },
        "workspace": "/home/user1/phoenix/"
      }
    ]
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "ref://env/OPENCLAW_GATEWAY_TOKEN"
    },
    "port": 18789,
    "bind": "loopback",
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "allowInsecureAuth": true
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send",
        "sms.search"
      ]
    },
    "reload": {
      "mode": "hot"
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "tools": {
    "profile": "coding",
    "web": {
      "search": {
        "enabled": false,
        "provider": "searxng"
      }
    },
    "exec": {
      "ask": "off",
      "security": "full"
    },
    "sessions": {
      "visibility": "all"
    },
    "agentToAgent": {
      "enabled": true,
      "allow": [
        "fz425-agent",
        "fz425-verifier",
        "main"
      ]
    }
  },
  "plugins": {
    "entries": {
      "deepseek": {
        "enabled": true
      },
      "telegram": {
        "enabled": true
      },
      "searxng": {
        "enabled": true
      }
    }
  },
  "models": {
